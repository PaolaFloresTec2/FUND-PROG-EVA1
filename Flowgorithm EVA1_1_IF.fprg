    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="edad" type="Integer" array="False" size=""/>
            <output expression="&quot;Cu&#225;l es tu edad&quot;" newline="True"/>
            <input variable="edad"/>
            <if expression="edad &gt;= 18">
                <then>
                    <output expression="&quot;Pasale jochis&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;No le pasas compita&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
